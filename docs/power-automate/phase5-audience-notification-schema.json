{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TOKIN Phase 5 audience notification",
  "type": "object",
  "required": [
    "schemaVersion",
    "event",
    "audience",
    "requestId",
    "requestNo",
    "recipient",
    "adaptiveCard",
    "emailSubject",
    "emailBodyHtml"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "event": {
      "type": "string",
      "enum": [
        "request.confirmation_required",
        "request.confirmed",
        "request.approved",
        "request.rejected",
        "request.changes_requested",
        "admin.request_ready",
        "admin.workflow_exception",
        "assignment.confirmed",
        "driver.assignment_offered",
        "workflow.reminder",
        "workflow.escalated"
      ]
    },
    "audience": {
      "type": "string",
      "enum": ["requester", "admin", "driver"]
    },
    "requestId": { "type": "string", "format": "uuid" },
    "requestNo": { "type": "string", "minLength": 3, "maxLength": 100 },
    "recipient": {
      "type": "object",
      "required": ["email"],
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "format": "email", "maxLength": 240 }
      },
      "additionalProperties": false
    },
    "adaptiveCard": { "type": "object" },
    "emailSubject": { "type": "string", "minLength": 1, "maxLength": 300 },
    "emailBodyHtml": { "type": "string", "minLength": 1 },
    "delivery": {
      "type": "object",
      "required": ["messageId", "attempt", "correlationId"],
      "properties": {
        "messageId": { "type": "string", "format": "uuid" },
        "attempt": { "type": "integer", "minimum": 1 },
        "correlationId": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
