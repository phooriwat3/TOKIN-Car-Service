    {"id":"roadmap-note","type":"text","x":65,"y":1900,"width":2080,"height":66,"angle":0,"strokeColor":"#6b21a8","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1610,"version":1,"versionNonce":2610,"isDeleted":false,"boundElements":null,"updated":1793077200000,"link":null,"locked":false,"fontSize":17,"fontFamily":1,"text":"CUTOVER RULE: do not replace Supabase staging until SQL Server feature parity, reference-data migration, notification delivery, security review, backup/restore, and user acceptance all pass.\nOWNERSHIP RULE: personal accounts are acceptable for temporary development only; production resources must be transferred to company-controlled accounts before internship handover.","textAlign":"center","verticalAlign":"top","containerId":null,"originalText":"CUTOVER RULE: do not replace Supabase staging until SQL Server feature parity, reference-data migration, notification delivery, security review, backup/restore, and user acceptance all pass.\nOWNERSHIP RULE: personal accounts are acceptable for temporary development only; production resources must be transferred to company-controlled accounts before internship handover.","autoResize":true,"lineHeight":1.25}
