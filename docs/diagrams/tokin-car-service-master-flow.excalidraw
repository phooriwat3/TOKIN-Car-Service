    {"id":"worker-text","type":"text","x":1460,"y":1018,"width":225,"height":105,"angle":0,"strokeColor":"#4c1d95","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1351,"version":1,"versionNonce":2351,"isDeleted":false,"boundElements":null,"updated":1793077200000,"link":null,"locked":false,"fontSize":16,"fontFamily":1,"text":"WORKFLOW OUTBOX WORKER\nLease pending messages\nRetry with exponential backoff\nDead-letter + manual retry\nDelivery idempotency\nSanitized operational errors","textAlign":"center","verticalAlign":"middle","containerId":null,"originalText":"WORKFLOW OUTBOX WORKER\nLease pending messages\nRetry with exponential backoff\nDead-letter + manual retry\nDelivery idempotency\nSanitized operational errors","autoResize":true,"lineHeight":1.25},
    {"id":"channels-box","type":"rectangle","x":1790,"y":995,"width":400,"height":150,"angle":0,"strokeColor":"#7c3aed","backgroundColor":"#f5f3ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1360,"version":1,"versionNonce":2360,"isDeleted":false,"boundElements":null,"updated":1793077200000,"link":null,"locked":false},
    {"id":"channels-text","type":"text","x":1820,"y":1018,"width":340,"height":105,"angle":0,"strokeColor":"#4c1d95","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1361,"version":1,"versionNonce":2361,"isDeleted":false,"boundElements":null,"updated":1793077200000,"link":null,"locked":false,"fontSize":17,"fontFamily":1,"text":"COMMUNICATION CHANNELS\nPower Automate → Teams card first → email fallback\nRequester: confirm / manage / status\nApprover: approve / reject / request changes\nGA: alerts and action queue\nDriver: LINE sent manually by GA","textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"COMMUNICATION CHANNELS\nPower Automate → Teams card first → email fallback\nRequester: confirm / manage / status\nApprover: approve / reject / request changes\nGA: alerts and action queue\nDriver: LINE sent manually by GA","autoResize":true,"lineHeight":1.25},
    {"id":"security-box","type":"rectangle","x":70,"y":1210,"width":610,"height":280,"angle":0,"strokeColor":"#b45309","backgroundColor":"#fffbeb","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1370,"version":1,"versionNonce":2370,"isDeleted":false,"boundElements":null,"updated":1793077200000,"link":null,"locked":false},
    {"id":"security-text","type":"text","x":100,"y":1235,"width":550,"height":230,"angle":0,"strokeColor":"#78350f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1371,"version":1,"versionNonce":2371,"isDeleted":false,"boundElements":null,"updated":1793077200000,"link":null,"locked":false,"fontSize":17,"fontFamily":1,"text":"SECURITY BOUNDARY\n• Public form: request-size limit, rate limit, honeypot, strict validation\n• Idempotency key prevents duplicate submissions and callbacks\n• Raw action tokens exist only in memory; SQL stores SHA-256 hashes\n• Outbox stores Data Protection ciphertext; no secret in browser or logs\n• Expiry + workflow version + recipient identity checked on every action\n• RBAC: requester / approver / GA admin / finance / auditor\n• SQL Server reachable only by backend; port 1433 is never public\n• Secrets live in host secret store; production key ring is persistent","textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"SECURITY BOUNDARY\n• Public form: request-size limit, rate limit, honeypot, strict validation\n• Idempotency key prevents duplicate submissions and callbacks\n• Raw action tokens exist only in memory; SQL stores SHA-256 hashes\n• Outbox stores Data Protection ciphertext; no secret in browser or logs\n• Expiry + workflow version + recipient identity checked on every action\n• RBAC: requester / approver / GA admin / finance / auditor\n• SQL Server reachable only by backend; port 1433 is never public\n• Secrets live in host secret store; production key ring is persistent","autoResize":true,"lineHeight":1.25},
    {"id":"ops-box","type":"rectangle","x":730,"y":1210,"width":610,"height":280,"angle":0,"strokeColor":"#0f766e","backgroundColor":"#ecfdf5","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1380,"version":1,"versionNonce":2380,"isDeleted":false,"boundElements":null,"updated":1793077200000,"link":null,"locked":false},
    {"id":"ops-text","type":"text","x":760,"y":1235,"width":550,"height":230,"angle":0,"strokeColor":"#14532d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1381,"version":1,"versionNonce":2381,"isDeleted":false,"boundElements":null,"updated":1793077200000,"link":null,"locked":false,"fontSize":17,"fontFamily":1,"text":"OPERATIONS & QUALITY\n• Health endpoint and dependency checks without exposing data\n• Structured logs with correlation IDs; no PII or tokens\n• Unit, API, workflow, concurrency, migration, and browser tests\n• CI builds, tests, formats, audits packages, and validates migrations\n• Outbox monitoring: pending / failed / dead-letter / delivered\n• Backup + restore drill, disaster-recovery paper/Excel fallback\n• 90-day operational data, controlled archive, retention policy\n• Immutable state-transition and dispatch evidence for audits","textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"OPERATIONS & QUALITY\n• Health endpoint and dependency checks without exposing data\n• Structured logs with correlation IDs; no PII or tokens\n• Unit, API, workflow, concurrency, migration, and browser tests\n• CI builds, tests, formats, audits packages, and validates migrations\n• Outbox monitoring: pending / failed / dead-letter / delivered\n• Backup + restore drill, disaster-recovery paper/Excel fallback\n• 90-day operational data, controlled archive, retention policy\n• Immutable state-transition and dispatch evidence for audits","autoResize":true,"lineHeight":1.25},
    {"id":"deploy-box","type":"rectangle","x":1390,"y":1210,"width":800,"height":280,"angle":0,"strokeColor":"#475569","backgroundColor":"#f1f5f9","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":1390,"version":1,"versionNonce":2390,"isDeleted":false,"boundElements":null,"updated":1793077200000,"link":null,"locked":false},
    {"id":"deploy-text","type":"text","x":1423,"y":1235,"width":735,"height":230,"angle":0,"strokeColor":"#334155","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1391,"version":1,"versionNonce":2391,"isDeleted":false,"boundElements":null,"updated":1793077200000,"link":null,"locked":false,"fontSize":17,"fontFamily":1,"text":"DEPLOYMENT & OWNERSHIP\nCURRENT STAGING: Netlify + personal Supabase project, frozen as a working reference\nTARGET: company-approved Windows/Linux host runs Next.js + ASP.NET Core; company SQL Server stays private\nPUBLIC EDGE (later): company domain → hosting provider / Cloudflare only after IT and provider approval\nOWNERSHIP BEFORE PRODUCTION:\n• Move Supabase/Netlify/Cloudflare/hosting resources from intern account to company-controlled owners\n• At least two company administrators; documented renewal, billing, recovery, and offboarding\n• Separate staging and production secrets/databases; never copy development credentials\nCUTOVER: feature flag → pilot department → reconciliation → rollback window → production approval","textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"DEPLOYMENT & OWNERSHIP\nCURRENT STAGING: Netlify + personal Supabase project, frozen as a working reference\nTARGET: company-approved Windows/Linux host runs Next.js + ASP.NET Core; company SQL Server stays private\nPUBLIC EDGE (later): company domain → hosting provider / Cloudflare only after IT and provider approval\nOWNERSHIP BEFORE PRODUCTION:\n• Move Supabase/Netlify/Cloudflare/hosting resources from intern account to company-controlled owners\n• At least two company administrators; documented renewal, billing, recovery, and offboarding\n• Separate staging and production secrets/databases; never copy development credentials\nCUTOVER: feature flag → pilot department → reconciliation → rollback window → production approval","autoResize":true,"lineHeight":1.25},

