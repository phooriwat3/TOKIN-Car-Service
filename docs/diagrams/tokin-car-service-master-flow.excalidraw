    {"id":"sql-text","type":"text","x":1047,"y":1017,"width":276,"height":105,"angle":0,"strokeColor":"#1e3a8a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":1341,"version":1,"versionNonce":2341,"isDeleted":false,"boundElements":null,"updated":1793077200000,"link":null,"locked":false,"fontSize":16,"fontFamily":1,"text":"PRIVATE SQL SERVER\ncore: departments / approvers / directory\ntransport: requests / riders / assignments\nsecurity: token hashes / idempotency\nworkflow: outbox / deliveries\naudit + infrastructure migrations","textAlign":"left","verticalAlign":"middle","containerId":null,"originalText":"PRIVATE SQL SERVER\ncore: departments / approvers / directory\ntransport: requests / riders / assignments\nsecurity: token hashes / idempotency\nworkflow: outbox / deliveries\naudit + infrastructure migrations","autoResize":true,"lineHeight":1.25},
