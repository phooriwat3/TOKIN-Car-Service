# Required in staging and production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated exact domains accepted by the employee request form.
# Configure the matching COMPANY_EMAIL_DOMAINS Edge Function secret too.
NEXT_PUBLIC_COMPANY_EMAIL_DOMAINS=yageo.com

# Local development only. This flag is ignored when NODE_ENV=production.
# Never enable demo mode in a public deployment.
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
