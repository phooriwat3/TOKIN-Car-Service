# Copy this file to .env in the same directory and replace every placeholder.
# This pilot API listens on localhost; an HTTPS proxy is needed for external access.
PILOT_API_PORT=18080
PILOT_SQL_CONNECTION_STRING='Server=pilot-sql.internal;Database=TokinCarServicePilot;User Id=tokin_pilot_app;Password=REPLACE_ME;Encrypt=True;TrustServerCertificate=False'
PILOT_CERTIFICATE_PASSWORD=REPLACE_ME
PILOT_DELIVERY_ENDPOINT_URL=https://approved-test-delivery.example/trigger
PILOT_APP_BASE_URL=https://temporary-pilot-site.example/
PILOT_DELIVERY_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PILOT_GA_EMAIL=approved-pilot-ga@example.com
PILOT_GA_GATEWAY_SHARED_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET
